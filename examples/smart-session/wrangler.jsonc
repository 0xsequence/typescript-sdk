{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "oms-smart-session-example",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-11",
  "alias": {
    "@polygonlabs/oms-wallet": "../../packages/oms-wallet/src/index.ts"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "oms-smart-session-example",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "OMS_PUBLISHABLE_KEY": "pk_dev_sdbx_01kqa06hyyetj_01kv5zt5s3eke9038q8y67jdvj",
    "WALLET_ORIGIN": "http://localhost:5173",
    "DASHBOARD_ORIGIN": "http://localhost:5174"
  }
}
