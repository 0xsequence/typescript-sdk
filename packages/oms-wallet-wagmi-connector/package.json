{
  "name": "@polygonlabs/oms-wallet-wagmi-connector",
  "version": "0.2.0",
  "description": "Wagmi connector for OMS Wallet.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "MIGRATION.md"
  ],
  "exports": {
    ".": {
      "@polygonlabs/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/0xPolygon/oms-wallet-typescript-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/0xPolygon/oms-wallet-typescript-sdk/issues"
  },
  "homepage": "https://github.com/0xPolygon/oms-wallet-typescript-sdk#readme",
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "clean": "rm -rf dist out-tsc *.tsbuildinfo",
    "typecheck": "tsc -b",
    "build": "pnpm clean && tsc -b tsconfig.lib.json",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm build && pnpm test",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@polygonlabs/oms-wallet": "workspace:^",
    "@wagmi/core": ">=3.5.0 <4",
    "viem": ">=2.48.4 <3"
  },
  "devDependencies": {
    "@polygonlabs/oms-wallet": "workspace:*",
    "@wagmi/core": "^3.6.5",
    "typescript": "^7.0.2",
    "viem": "^2.48.4",
    "vitest": "^5.0.0"
  }
}
